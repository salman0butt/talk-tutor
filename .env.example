# Gemini Live + post-session feedback
# Recommended local file: .env.local. Avoid defining the same key in multiple
# .env* files because higher-priority files can shadow lower-priority values.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash
GEMINI_FEEDBACK_MODEL=gemini-2.5-flash

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe hosted Checkout + Billing Portal
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Public application origin used for metadata, auth and fixed billing return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
